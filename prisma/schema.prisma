// Lady Dress POS - Database Schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ──────────── SUPPLIERS (shops we buy from in Turkey) ────────────
model Supplier {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  categories  Category[]
  createdAt   DateTime   @default(now())
}

// ──────────── CATEGORIES (per supplier: Vests, Dresses...) ────────────
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  products    Product[]

  supplierId  Int
  supplier    Supplier  @relation(fields: [supplierId], references: [id])

  createdAt   DateTime  @default(now())

  @@unique([supplierId, name])
  @@index([supplierId])
}

// ──────────── PRODUCTS ────────────
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  brand       String?
  basePrice   Float     // default price (variants can override)
  costPrice   Float?    // what you paid the supplier (for profit calc)
  imageUrl    String?
  isActive    Boolean   @default(true)

  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])

  variants    Variant[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ──────────── VARIANTS (size + color combos) ────────────
model Variant {
  id          Int       @id @default(autoincrement())
  sku         String    @unique             // e.g., FSD-S-RED
  barcode     String?   @unique             // scannable barcode
  size        String?                       // S, M, L, XL, 36, 38...
  color       String?                       // Red, Blue, Black...
  price       Float?                        // overrides product.basePrice if set
  stock       Int       @default(0)         // current quantity in shop
  lowStockAt  Int       @default(3)         // alert when stock <= this

  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  saleItems       SaleItem[]
  stockMovements  StockMovement[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
}

// ──────────── SALES (transactions) ────────────
model Sale {
  id            Int        @id @default(autoincrement())
  receiptNo     String     @unique          // e.g., R-20260426-0001
  total         Float
  discount      Float      @default(0)
  paymentMethod String                       // CASH, CARD
  channel       String     @default("SHOP")  // SHOP, ONLINE
  cashierName   String?
  notes         String?

  items         SaleItem[]

  createdAt     DateTime   @default(now())

  @@index([createdAt])
  @@index([channel])
}

// ──────────── SALE ITEMS (line items) ────────────
model SaleItem {
  id          Int      @id @default(autoincrement())
  quantity    Int
  unitPrice   Float                          // price at time of sale (history)
  subtotal    Float

  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  variantId   Int
  variant     Variant  @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
}

// ──────────── STOCK MOVEMENTS (audit log) ────────────
model StockMovement {
  id          Int      @id @default(autoincrement())
  type        String                          // SALE, RESTOCK, RETURN, ADJUSTMENT
  quantity    Int                             // positive = added, negative = removed
  reason      String?
  reference   String?                         // receipt no, supplier invoice...

  variantId   Int
  variant     Variant  @relation(fields: [variantId], references: [id])

  createdAt   DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
}
// ──────────── MONTHLY FEES (constant costs: rent, salaries, electricity...) ────────────
// A fee repeats every month from startMonth until endMonth (exclusive) at its
// default amount, unless that month has its own Expense row.
model MonthlyFee {
  id          Int       @id @default(autoincrement())
  name        String
  amount      Float                          // default amount each month
  startMonth  String                         // YYYY-MM
  endMonth    String?                        // YYYY-MM, null = still active

  expenses    Expense[]

  createdAt   DateTime  @default(now())
}

// ──────────── EXPENSES (per-month amounts + one-off extra fees) ────────────
model Expense {
  id          Int         @id @default(autoincrement())
  month       String                         // YYYY-MM
  name        String
  amount      Float

  feeId       Int?                           // null = one-off extra fee
  fee         MonthlyFee? @relation(fields: [feeId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())

  @@unique([month, feeId])
  @@index([month])
}

// ──────────── USERS (who can log in) ────────────
model User {
  id           Int       @id @default(autoincrement())
  name         String    @unique                // login name
  passwordHash String                           // scrypt: salt:hash (hex)
  role         String    @default("STAFF")      // ADMIN, STAFF

  sessions     Session[]

  createdAt    DateTime  @default(now())
}

// ──────────── SESSIONS (one per logged-in browser) ────────────
model Session {
  id          String    @id                     // sha256 of the cookie token
  expiresAt   DateTime

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([userId])
}
